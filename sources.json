{
  "$schema": "./schemas/sources.schema.json",
  "version": 1,
  "title": "Ranvier",
  "baseUrl": "/Ranvier.Docs/",
  "origin": "https://ranvier-org.github.io",
  "sources": [
    {
      "id": "core",
      "category": "Core & Reactive",
      "title": "Reactive core",
      "repository": "ranvier-org/Ranvier",
      "ref": "master",
      "local": "../Ranvier"
    },
    {
      "id": "persistence",
      "category": "Core & Reactive",
      "title": "Persistence",
      "repository": "ranvier-org/Ranvier.Persistence",
      "ref": "main",
      "local": "../Ranvier.Persistence"
    },
    {
      "id": "barewire",
      "category": "Core & Reactive",
      "title": "BAREWire",
      "repository": "ranvier-org/Ranvier.BAREWire",
      "ref": "main",
      "local": "../Ranvier.BAREWire"
    },
    {
      "id": "view",
      "category": "Views & Styling",
      "title": "Views and motion",
      "repository": "ranvier-org/Ranvier.View",
      "ref": "main",
      "local": "../Ranvier.View",
      "defaults": {
        "browserBundles": [
          { "path": "examples/Fable.Ranvier.Playground/dist", "route": "examples/playground" },
          { "path": "examples/Ranvier.Motion/dist", "route": "examples/motion" },
          { "path": "examples/Ranvier.Hydration/dist", "route": "examples/hydration" }
        ]
      }
    },
    {
      "id": "css",
      "category": "Views & Styling",
      "title": "Typed CSS",
      "repository": "ranvier-org/Ranvier.Css",
      "ref": "main",
      "local": "../Ranvier.Css"
    },
    {
      "id": "anime",
      "category": "Views & Styling",
      "title": "Animation",
      "repository": "ranvier-org/Ranvier.Anime",
      "ref": "main",
      "local": "../Ranvier.Anime"
    },
    {
      "id": "keyboard",
      "category": "Views & Styling",
      "title": "Keyboard",
      "repository": "ranvier-org/Ranvier.Keyboard",
      "ref": "main",
      "local": "../Ranvier.Keyboard"
    },
    {
      "id": "webcore",
      "category": "Platform & Graphics",
      "title": "WebCore host",
      "description": "Native cross-platform HTML/CSS/SVG layout, rendering, accessibility, and SDL3 windowing host.",
      "repository": "ranvier-org/Ranvier.WebCore",
      "ref": "main",
      "local": "../Ranvier.WebCore",
      "content": "docs"
    },
    {
      "id": "terminal",
      "category": "Platform & Graphics",
      "title": "Terminal UI",
      "repository": "ranvier-org/Ranvier.Terminal",
      "ref": "main",
      "local": "../Ranvier.Terminal"
    },
    {
      "id": "wgpu",
      "category": "Platform & Graphics",
      "title": "WebGPU 3D (Wgpu)",
      "repository": "ranvier-org/Ranvier.Wgpu",
      "ref": "main",
      "local": "../Ranvier.Wgpu"
    },
    {
      "id": "d5",
      "category": "Platform & Graphics",
      "title": "Data visualization (D5)",
      "repository": "ranvier-org/Ranvier.D5",
      "ref": "main",
      "local": "../Ranvier.D5"
    },
    {
      "id": "examples",
      "category": "Tooling & Guides",
      "title": "Application workflows",
      "repository": "ranvier-org/Ranvier.Examples",
      "ref": "main",
      "local": "../Ranvier.Examples"
    },
    {
      "id": "fsharp",
      "category": "Tooling & Guides",
      "title": "F# semantic tooling (rfs)",
      "repository": "ranvier-org/ranvier-fsharp",
      "ref": "main",
      "local": "../ranvier-fsharp"
    },
    {
      "id": "rocq",
      "category": "Tooling & Guides",
      "title": "Rocq proofs & Navigator",
      "repository": "ranvier-org/FSharp.Data.Rocq",
      "ref": "main",
      "local": "../FSharp.Data.Rocq"
    },
    {
      "id": "docs",
      "category": "Tooling & Guides",
      "title": "Documentation authoring",
      "repository": "ranvier-org/Ranvier.Docs",
      "ref": "main",
      "self": true
    },
    {
      "id": "core-performance",
      "kind": "dataset",
      "repository": "ranvier-org/Ranvier",
      "ref": "perf-data"
    }
  ]
