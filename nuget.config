<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="xantham" value="https://nuget.cloudsmith.io/shayanhabibi/xantham/v3/index.json" />
    <!-- The live example plugin, built from the Nacara fork and committed under feed/. -->
    <add key="partas-local" value="feed" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="partas-local"><package pattern="Nacara.Plugin.LiveExample" /></packageSource>
    <packageSource key="xantham"><package pattern="Xantham.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
