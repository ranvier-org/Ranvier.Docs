<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <DefineConstants>$(DefineConstants);RANVIER_TRACE</DefineConstants>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>Ranvier.Docs.Maps</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Helpers.fs" />
        <Compile Include="Replay.fs" />
        <Compile Include="MapModel.fs" />
        <Compile Include="Layout.fs" />
        <Compile Include="SceneView.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(RanvierRoot)/src/Ranvier/Ranvier.fsproj" />
    </ItemGroup>

</Project>
